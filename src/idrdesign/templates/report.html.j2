<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>idrdesign report — {{ target_name }}</title>
<style>
body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; margin: 2em; max-width: 1200px; }
h1 { border-bottom: 2px solid #333; padding-bottom: 0.2em; }
h2 { margin-top: 2em; border-bottom: 1px solid #ccc; padding-bottom: 0.1em; }
table { border-collapse: collapse; margin: 1em 0; }
th, td { border: 1px solid #ccc; padding: 0.3em 0.6em; font-size: 0.9em; }
th { background: #f5f5f5; }
.seq-block { font-family: monospace; font-size: 0.85em; word-break: break-all; margin: 0.2em 0 0.8em 0; }
.meta { color: #666; font-size: 0.85em; }
svg { max-width: 100%; height: auto; }
</style>
</head>
<body>
<h1>idrdesign — {{ target_name }}</h1>
<p class="meta">
Target length: {{ target_seq|length }} aa &nbsp;•&nbsp;
Generated: {{ generated_at }}
</p>

<h2>1. Run summary</h2>
<table>
<tr><th>Parameter</th><th>Value</th></tr>
{% for k, v in config_summary.items() %}
<tr><td>{{ k }}</td><td>{{ v }}</td></tr>
{% endfor %}
</table>

<h2>2. Sequences</h2>
<div>
  <strong>target ({{ target_name }})</strong>
  <div class="seq-block">{{ target_seq }}</div>
</div>
{% for d in designs %}
<div>
  <strong>design_{{ "%02d"|format(loop.index0) }}</strong>
  &nbsp;cos_sim={{ "%.4f"|format(d.final_cosine_similarity) }}
  &nbsp;iters={{ d.iterations }}
  &nbsp;{{ d.convergence_status }}
  <div class="seq-block">{{ d.sequence }}</div>
</div>
{% endfor %}

<h2>3. Optimization trajectories</h2>
{{ trajectories_svg | safe }}

<h2>4. Rg distributions</h2>
{{ rg_svg | safe }}

<h2>5. End-to-end distance</h2>
{{ ree_svg | safe }}

<h2>6. Asphericity</h2>
{{ asph_svg | safe }}

<h2>7. Mean distance maps — design − target</h2>
{% for name, svg in delta_maps %}
<div>
  <strong>{{ name }}</strong>
  {{ svg | safe }}
</div>
{% endfor %}

</body>
</html>
